{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "PL v0.3 carrier presentation",
  "description": "A named cut. Not an essence. G not Gamma.",
  "type": "object",
  "required": ["name", "version", "V", "G", "theta", "forced_on_cut", "fails", "falsifier"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "V": {"type": "string", "description": "alphabet of this presentation"},
    "G": {"type": "string", "description": "declared operations / isolation"},
    "theta": {"type": "string", "description": "admission / refusal / budget"},
    "forced_on_cut": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fails": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "falsifier": {"type": "string"},
    "notes": {"type": "string"}
  }
}
